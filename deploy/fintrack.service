[Unit]
Description=FinTrack API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/fintrack/backend
EnvironmentFile=/home/ubuntu/fintrack/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/fintrack/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
