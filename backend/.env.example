# =============================================================================
# FinTrack — example environment (copy to .env and fill values)
# =============================================================================

# Server
HOST=0.0.0.0
PORT=8000
BASE_CURRENCY=EUR
TIMEZONE=Europe/Madrid

# LLM provider: gemini | groq | anthropic
LLM_PROVIDER=gemini

# Google AI Studio — free tier sufficient for FinTrack
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_ORCHESTRATOR=gemini-2.5-pro
GEMINI_MODEL_AGENT=gemini-2.5-flash
GEMINI_MODEL_CHEAP=gemini-2.5-flash-lite

# Groq — fallback (https://console.groq.com)
GROQ_API_KEY=

# Anthropic — optional, only if you add billing
ANTHROPIC_API_KEY=

# Kraken — read-only API key (Query Funds + Query Trades)
# Generate at https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Trade Republic (pytr login, filled at runtime)
TR_PHONE=
TR_PIN=

# Telegram bot for alerts (talk to @BotFather) — owner-only until Fase 2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth login (multi-user, Fase 1)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random signing key for the session cookie — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=
# Comma-separated allowlist — only these emails can log in
ALLOWED_EMAILS=
# Your own email (must be in ALLOWED_EMAILS) — used by features not yet
# generalized per-user (Kraken, Telegram, alerts, daily briefing, opportunities'
# "exclude what you hold"). Set this AFTER your first login.
OWNER_EMAIL=

# Optional data providers
FRED_API_KEY=
ETHERSCAN_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Shared secret gating admin/cron-triggered endpoints (systematic, polymarket, creators)
CREATORS_INGEST_SECRET=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/fintrack.db

